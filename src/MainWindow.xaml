<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Cleaner" Width="1040" Height="780" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="B2V"/>

    <!-- Level selector: a RadioButton drawn as a card -->
    <Style x:Key="NivelCard" TargetType="RadioButton">
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" Background="White" BorderBrush="#D1D5DB" BorderThickness="2" CornerRadius="8" Padding="16,10">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#93C5FD"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="#2563EB"/>
                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Margin" Value="8,0,0,0"/>
      <Setter Property="MinWidth" Value="96"/>
    </Style>
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header: title, disks, admin -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="Auto Cleaner" FontSize="24" FontWeight="SemiBold" Foreground="#111827"/>
        <TextBlock x:Name="TxtDiscos" Foreground="#374151" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button x:Name="BtnAdmin" Content="Reiniciar como administrador" Padding="12,6" HorizontalAlignment="Right"/>
        <TextBlock x:Name="TxtAdmin" Foreground="#6B7280" FontSize="12" Margin="0,4,0,0" TextAlignment="Right"/>
      </StackPanel>
    </Grid>

    <!-- Levels -->
    <StackPanel Grid.Row="1" Orientation="Horizontal">
      <RadioButton x:Name="RbRapida" GroupName="Nivel" Style="{StaticResource NivelCard}">
        <StackPanel Width="190">
          <TextBlock Text="Rápida" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Segundos · só risco baixo" Foreground="#6B7280" FontSize="12"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="RbMedia" GroupName="Nivel" Style="{StaticResource NivelCard}">
        <StackPanel Width="190">
          <TextBlock Text="Média" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Minutos · baixo e médio" Foreground="#6B7280" FontSize="12"/>
        </StackPanel>
      </RadioButton>
      <RadioButton x:Name="RbCompleta" GroupName="Nivel" Style="{StaticResource NivelCard}">
        <StackPanel Width="190">
          <TextBlock Text="Completa" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Pode passar de 1 hora · tudo" Foreground="#6B7280" FontSize="12"/>
        </StackPanel>
      </RadioButton>
    </StackPanel>

    <Grid Grid.Row="2" Margin="0,10,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TxtDescNivel" Foreground="#374151" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0">
        <TextBlock Text="Mostrar até o risco:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#374151"/>
        <ComboBox x:Name="CmbRisco" Width="110" SelectedIndex="2">
          <ComboBoxItem Content="Baixo"/>
          <ComboBoxItem Content="Médio"/>
          <ComboBoxItem Content="Alto"/>
        </ComboBox>
      </StackPanel>
    </Grid>

    <!-- Item list -->
    <Border Grid.Row="3" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="Lista" Margin="12,4,12,10" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="#6B7280" Margin="0,14,0,4"/>
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Padding="0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="90"/>
                  </Grid.ColumnDefinitions>
                  <CheckBox IsChecked="{Binding Selecionado, Mode=TwoWay}" IsEnabled="{Binding Habilitado}" VerticalAlignment="Top" Margin="2,3,0,0"/>
                  <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding Nome}" FontWeight="SemiBold" Foreground="#111827"/>
                      <Border x:Name="Tag" CornerRadius="3" Padding="6,1" Margin="10,0,0,0" Background="#15803D" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RiscoTexto}" Foreground="White" FontSize="10" FontWeight="Bold"/>
                      </Border>
                      <Border CornerRadius="3" Padding="6,1" Margin="6,0,0,0" Background="#4B5563" VerticalAlignment="Center"
                              Visibility="{Binding Admin, Converter={StaticResource B2V}}">
                        <TextBlock Text="ADMIN" Foreground="White" FontSize="10" FontWeight="Bold"/>
                      </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Descricao}" Foreground="#374151" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    <TextBlock Text="{Binding Consequencia}" Foreground="#6B7280" FontStyle="Italic" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="#6B7280" FontSize="12" TextWrapping="Wrap"
                             TextAlignment="Right" VerticalAlignment="Top" Margin="12,2,0,0"/>
                  <TextBlock Grid.Column="3" Text="{Binding TamanhoTexto}" FontWeight="SemiBold" Foreground="#111827"
                             TextAlignment="Right" VerticalAlignment="Top" Margin="0,1,4,0"/>
                </Grid>
              </Border>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Risco}" Value="medio">
                  <Setter TargetName="Tag" Property="Background" Value="#B45309"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Risco}" Value="alto">
                  <Setter TargetName="Tag" Property="Background" Value="#B91C1C"/>
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="4" Margin="0,14,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock x:Name="TxtTotal" FontSize="15" FontWeight="SemiBold" Foreground="#111827" VerticalAlignment="Center"/>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button x:Name="BtnLog" Content="Abrir log" Style="{StaticResource Btn}"/>
        <Button x:Name="BtnCancelar" Content="Cancelar" Style="{StaticResource Btn}" IsEnabled="False"/>
        <Button x:Name="BtnAnalisar" Content="Analisar" Style="{StaticResource Btn}"/>
        <Button x:Name="BtnExecutar" Content="Executar selecionados" Style="{StaticResource Btn}" FontWeight="SemiBold"/>
      </StackPanel>
      <ProgressBar x:Name="Barra" Grid.Row="1" Grid.ColumnSpan="2" Height="6" Margin="0,12,0,0" Minimum="0" Maximum="1"/>
      <TextBlock x:Name="TxtStatus" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0" Foreground="#6B7280" FontSize="12"/>
    </Grid>
  </Grid>
</Window>
