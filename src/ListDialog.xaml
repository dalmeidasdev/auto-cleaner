<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" Height="560" MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F3F4F6" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" Foreground="#374151" Margin="0,0,0,12"/>
    <Border Grid.Row="1" Background="White" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="8">
        <ListBox x:Name="Linhas" Margin="12,4" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="False">
          <ListBox.ItemContainerStyle>
            <Style TargetType="ListBoxItem">
              <Setter Property="Focusable" Value="False"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate>
                </Setter.Value>
              </Setter>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="#E5E7EB" BorderThickness="0,0,0,1" Padding="0,7">
                <CheckBox IsChecked="{Binding Marcado, Mode=TwoWay}" IsEnabled="{Binding Habilitado}">
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="{Binding Titulo}" FontWeight="SemiBold" Foreground="#111827"/>
                    <TextBlock Text="{Binding Detalhe}" Foreground="#6B7280" FontSize="12" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </CheckBox>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
    </Border>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
      <Button x:Name="BtnFechar" Content="Cancelar" Padding="16,8" MinWidth="96" IsCancel="True"/>
      <Button x:Name="BtnOk" Padding="16,8" MinWidth="96" Margin="8,0,0,0" FontWeight="SemiBold" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
